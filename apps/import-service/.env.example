# Server Configuration
PORT=3000
NODE_ENV=development

# AI Service (choose one)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Cloud Storage
GCS_BUCKET_NAME=straion-imports
# AWS_S3_BUCKET=straion-imports
# AWS_REGION=us-east-1

# Logging
LOG_LEVEL=info

# Optional: Straion Platform Integration
# STRAION_WEBHOOK_URL=https://platform.straion.com/webhooks/import
# STRAION_API_KEY=your_straion_api_key
