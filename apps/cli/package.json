{
  "name": "@straion/cli",
  "version": "1.0.0",
  "description": "CLI tool for importing documents into Straion",
  "main": "dist/index.js",
  "bin": {
    "straion": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && cp confluence-api.json dist/",
    "clean": "rm -rf dist | rm tsconfig.tsbuildinfo",
    "generate-types": "npx openapicmd typegen ./confluence-api.json > src/types/confluence-api.d.ts",
    "prebuild": "pnpm generate-types",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "keywords": [
    "straion",
    "cli",
    "document-import"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@straion/shared": "workspace:*",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "inquirer": "^9.2.12",
    "nest-commander": "^3.20.1",
    "openapi-client-axios": "^7.8.0",
    "openapicmd": "^2.7.0",
    "ora": "^5.4.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.20",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.10.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
