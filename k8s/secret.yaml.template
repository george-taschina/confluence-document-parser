# Template for Kubernetes secrets
# Copy this file to secret.yaml and replace the placeholder values
# DO NOT commit secret.yaml to version control

apiVersion: v1
kind: Secret
metadata:
  name: api-secrets
type: Opaque
stringData:
  anthropic-key: "YOUR_ANTHROPIC_API_KEY_HERE"
  # Add other secrets as needed
  # openai-key: "YOUR_OPENAI_API_KEY_HERE"
  # gcs-credentials: "YOUR_GCS_CREDENTIALS_JSON_HERE"

# Alternative: Create secret using kubectl command
# kubectl create secret generic api-secrets \
#   --from-literal=anthropic-key=$ANTHROPIC_API_KEY
